#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_clean:
	# Skip Python build cleaning

override_dh_auto_configure:
	# Skip Python configure

override_dh_auto_build:
	# Pure Python package; nothing to compile.

override_dh_auto_test:
	# Skip Python tests

override_dh_installdocs:
	# Skip docs

override_dh_installchangelogs:
	# Skip changelogs

override_dh_auto_install:
	# Install the importable package
	mkdir -p debian/jottr/usr/lib/python3/dist-packages
	cp -a src/jottr debian/jottr/usr/lib/python3/dist-packages/jottr
	# Drop bundler specs / macOS assets from the Linux package tree
	rm -f debian/jottr/usr/lib/python3/dist-packages/jottr/jottr-mac.spec \
		debian/jottr/usr/lib/python3/dist-packages/jottr/jottr-windows.spec \
		debian/jottr/usr/lib/python3/dist-packages/jottr/jottr_icon.icns
	find debian/jottr/usr/lib/python3/dist-packages/jottr -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true

	# Shared data (icons / translations) looked up via jottr.paths
	mkdir -p debian/jottr/usr/share/jottr
	cp -a icons debian/jottr/usr/share/jottr/icons
	cp -a translations debian/jottr/usr/share/jottr/translations

	# Desktop entry must match QGuiApplication.setDesktopFileName
	# ("io.github.mfat.jottr") so GNOME/KDE can map the running window
	# to this launcher instead of showing a generic dock icon.
	mkdir -p debian/jottr/usr/share/applications
	mkdir -p debian/jottr/usr/share/icons/hicolor/scalable/apps
	cp packaging/debian/jottr.desktop \
		debian/jottr/usr/share/applications/io.github.mfat.jottr.desktop
	if [ -f icons/jottr.svg ]; then \
		cp icons/jottr.svg \
			debian/jottr/usr/share/icons/hicolor/scalable/apps/io.github.mfat.jottr.svg; \
	elif [ -f src/jottr/icons/jottr.svg ]; then \
		cp src/jottr/icons/jottr.svg \
			debian/jottr/usr/share/icons/hicolor/scalable/apps/io.github.mfat.jottr.svg; \
	fi

	# Launcher
	mkdir -p debian/jottr/usr/bin
	printf '%s\n' '#!/bin/sh' 'exec python3 -m jottr "$$@"' > debian/jottr/usr/bin/jottr
	chmod +x debian/jottr/usr/bin/jottr
