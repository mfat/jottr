#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_clean:
	# Skip Python build cleaning
	rm -rf src/jottr/qt_plugins vendor/adwaita-qt/build

override_dh_auto_configure:
	# Skip Python configure

override_dh_auto_build:
	# Bundle Adwaita-Qt style plugin into src/jottr/qt_plugins/
	./scripts/build-adwaita-qt.sh

override_dh_auto_test:
	# Skip Python tests

override_dh_installdocs:
	# Skip docs

override_dh_installchangelogs:
	# Skip changelogs

override_dh_shlibdeps:
	# Plugin links Qt privately via PyQt6; ignore unresolved Qt SONAMEs from
	# the style plugin when scanning with system tools.
	dh_shlibdeps -- -xlibqt6core6t64 -xlibqt6gui6 -xlibqt6widgets6 || dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

override_dh_auto_install:
	# Install the importable package (includes bundled qt_plugins/)
	mkdir -p debian/jottr/usr/lib/python3/dist-packages
	cp -a src/jottr debian/jottr/usr/lib/python3/dist-packages/jottr
	# Drop bundler specs / macOS assets from the Linux package tree
	rm -f debian/jottr/usr/lib/python3/dist-packages/jottr/jottr-mac.spec \
		debian/jottr/usr/lib/python3/dist-packages/jottr/jottr-windows.spec \
		debian/jottr/usr/lib/python3/dist-packages/jottr/jottr_icon.icns
	find debian/jottr/usr/lib/python3/dist-packages/jottr -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true

	# Shared data (icons / translations) looked up via jottr.paths
	mkdir -p debian/jottr/usr/share/jottr
	cp -a icons debian/jottr/usr/share/jottr/icons
	cp -a translations debian/jottr/usr/share/jottr/translations

	# Desktop entry + app icon
	mkdir -p debian/jottr/usr/share/applications
	mkdir -p debian/jottr/usr/share/icons/hicolor/128x128/apps
	cp packaging/debian/jottr.desktop debian/jottr/usr/share/applications/
	if [ -f icons/jottr.png ]; then \
		cp icons/jottr.png debian/jottr/usr/share/icons/hicolor/128x128/apps/; \
	elif [ -f src/jottr/icons/jottr.png ]; then \
		cp src/jottr/icons/jottr.png debian/jottr/usr/share/icons/hicolor/128x128/apps/; \
	fi

	# Launcher
	mkdir -p debian/jottr/usr/bin
	printf '%s\n' '#!/bin/sh' 'exec python3 -m jottr "$$@"' > debian/jottr/usr/bin/jottr
	chmod +x debian/jottr/usr/bin/jottr
